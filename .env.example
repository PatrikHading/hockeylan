# Copy this file to .env before starting the local Docker environment.
#
# These values are intended only for local development.
# Do not reuse local credentials in production.

# Application ports exposed on the host
BACKEND_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL exposed on the host
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hockeylan
DB_USERNAME=hockeylan
DB_PASSWORD=replace-with-a-local-only-password

# Explicit browser origins allowed to use credentialed CORS.
# Separate multiple origins with commas and never use wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Browser-accessible application URLs
QR_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=/api

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_CAPACITY=120
RATE_LIMIT_API_REFILL_TOKENS=120
RATE_LIMIT_API_REFILL_PERIOD_SECONDS=60
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_TOKENS=5
RATE_LIMIT_LOGIN_REFILL_PERIOD_SECONDS=300
RATE_LIMIT_IDLE_ENTRY_TTL_SECONDS=900
RATE_LIMIT_MAX_ENTRIES=10000

# Administrator session lifetime
ADMIN_SESSION_TIMEOUT=30m

# Initial administrator creation is disabled during normal startup.
# Supply the bootstrap values only for the one-time bootstrap command.
ADMIN_BOOTSTRAP_ENABLED=false

# Do not store real bootstrap credentials in this example file.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=