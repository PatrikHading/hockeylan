DB_NAME=hockeylan
DB_USERNAME=replace-with-production-database-user
DB_PASSWORD=replace-with-a-long-random-secret

CORS_ALLOWED_ORIGINS=https://replace-with-production-domain.example
QR_BASE_URL=https://replace-with-production-domain.example
VITE_API_BASE_URL=/api

FRONTEND_PORT=5173

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_CAPACITY=120
RATE_LIMIT_API_REFILL_TOKENS=120
RATE_LIMIT_API_REFILL_PERIOD_SECONDS=60
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_TOKENS=5
RATE_LIMIT_LOGIN_REFILL_PERIOD_SECONDS=300
RATE_LIMIT_IDLE_ENTRY_TTL_SECONDS=900
RATE_LIMIT_MAX_ENTRIES=10000

ADMIN_SESSION_TIMEOUT=30m
MAX_JSON_PAYLOAD_BYTES=65536

ADMIN_BOOTSTRAP_ENABLED=false