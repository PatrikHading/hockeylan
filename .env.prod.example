# Production configuration template for Hockeylån.
# Copy this file to .env.prod on the production server.
# Protect .env.prod and never commit it.
#
# Replace every secret placeholder before deployment.
# Do not store real credentials in this example file.

# PostgreSQL
DB_NAME=hockeylan
DB_USERNAME=replace-with-production-database-user
DB_PASSWORD=replace-with-a-long-random-secret

# Public production address
CORS_ALLOWED_ORIGINS=https://bkflagg.norops.se
QR_BASE_URL=https://bkflagg.norops.se

# The frontend uses the same-origin Nginx /api proxy.
# Never place secrets in VITE variables because they are embedded in the browser build.
VITE_API_BASE_URL=/api

# Used when the production Compose configuration publishes the frontend
# on a loopback-only host port. The server-specific override removes host ports.
FRONTEND_PORT=5173

# JVM and application time zone
APP_TIME_ZONE=Europe/Stockholm

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_CAPACITY=120
RATE_LIMIT_API_REFILL_TOKENS=120
RATE_LIMIT_API_REFILL_PERIOD_SECONDS=60
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_REFILL_TOKENS=5
RATE_LIMIT_LOGIN_REFILL_PERIOD_SECONDS=300
RATE_LIMIT_IDLE_ENTRY_TTL_SECONDS=900
RATE_LIMIT_MAX_ENTRIES=10000

# Administrator session lifetime
ADMIN_SESSION_TIMEOUT=30m

# Maximum accepted JSON request size
MAX_JSON_PAYLOAD_BYTES=65536

# Initial administrator creation must remain disabled during normal startup.
# Supply bootstrap credentials only to the one-time bootstrap command.
ADMIN_BOOTSTRAP_ENABLED=false